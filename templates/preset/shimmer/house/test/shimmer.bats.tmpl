setup() {
  cd "$BATS_TEST_DIRNAME/.."
  HOUSE="$PWD"
}

@test "mise.toml pins shimmer to an exact release and declares the shiv plugin" {
  version="$(sed -n 's/^"shiv:shimmer" = "\(.*\)"$/\1/p' "$HOUSE/mise.toml")"
  [[ "$version" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+ ]]
  grep -qx '\[plugins\]' "$HOUSE/mise.toml"
  grep -qx 'shiv = "https://github.com/KnickKnackLabs/vfox-shiv"' "$HOUSE/mise.toml"
}

@test "agent:list prints the roster minus the housekeeper" {
  expected="$(awk -F '\t' '!/^#/ && NF && $1 != "{{HOUSEKEEPER}}" { print $1 }' "$HOUSE/roster.tsv")"
  run mise run -q agent:list
  [ "$status" -eq 0 ]
  [ "$output" = "$expected" ]
}
