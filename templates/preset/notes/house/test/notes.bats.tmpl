setup() {
  HOUSE="$(cd "$BATS_TEST_DIRNAME/.." && pwd)"
}

@test "mise.toml pins notes to an exact release and declares the shiv plugin" {
  version="$(sed -n 's/^"shiv:notes" = "\(.*\)"$/\1/p' "$HOUSE/mise.toml")"
  [[ "$version" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+ ]]
  grep -qx '\[plugins\]' "$HOUSE/mise.toml"
  grep -qx 'shiv = "https://github.com/KnickKnackLabs/vfox-shiv"' "$HOUSE/mise.toml"
}

@test "the contract says notes are encrypted and are committed only through notes" {
  grep -q '^\*\*Notes are encrypted here\*\*' "$HOUSE/AGENTS.md"
  grep -q 'notes commit' "$HOUSE/AGENTS.md"
  ! grep -q '^### Encrypt `notes/` with git-crypt$' "$HOUSE/notes/household-backlog.md"
}
