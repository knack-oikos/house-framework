#!/usr/bin/env bash
#MISE description="Render the example house fresh and compare it with examples/; --write replaces examples/ with the render"
#MISE dir="{{ config_root }}"
#USAGE flag "--write" help="Replace examples/ with the fresh render instead of comparing"
set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/house.sh"

EXAMPLES="${HOUSE_EXAMPLES_DIR:-$HOUSE_REPO_DIR/examples}"
WRITE="${usage_write:-false}"

scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT
home="$scratch/home"
fresh="$scratch/fresh"
mkdir -p "$home" "$fresh"

example() {
  local task="$1"
  shift
  env HOME="$home" \
    MISE_DATA_DIR="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}" \
    MISE_CACHE_DIR="${MISE_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/mise}" \
    MISE_TRUSTED_CONFIG_PATHS="$HOUSE_REPO_DIR:$home" \
    MISE_AUTO_INSTALL=0 \
    HOUSE_AGENTS_ROOT="$home/agents" \
    HOUSE_DEFINITIONS_DIR="$home/.claude/agents" \
    HOUSE_TODAY=2026-01-01 \
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=user.name GIT_CONFIG_VALUE_0= \
    mise run -q "$task" "$@" >/dev/null
}

house="$home/Work/hearth"
example init hearth --at "$house" --no-commit
example agent:add vulcan --house "$house" --role backend --owns server/ \
  --charge 'Owns the schema, the domain model and the API.'
example agent:add argus --house "$house" --role 'review and security' \
  --charge 'Reads every pull request into main before the owner merges it.'
example rules:add review --house "$house" --binds argus
find "$home" -type d -name .git -prune -exec rm -rf {} +
mv "$house" "$fresh/hearth"
mv "$home/agents" "$fresh/agents"

if [ "$WRITE" = "true" ]; then
  rm -rf "$EXAMPLES"
  mkdir -p "$(dirname "$EXAMPLES")"
  cp -R "$fresh" "$EXAMPLES"
  say "write: $(display_path "$EXAMPLES") is a fresh render of the templates"
  exit 0
fi

[ -d "$EXAMPLES" ] || die "$(display_path "$EXAMPLES") is missing → mise run examples --write"
if diff -r "$EXAMPLES" "$fresh"; then
  say "examples: $(display_path "$EXAMPLES") matches a fresh render"
else
  say ""
  die "$(display_path "$EXAMPLES") has drifted from the templates (diff above: < is examples/, > is the fresh render) → mise run examples --write, and commit it"
fi
