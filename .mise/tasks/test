#!/usr/bin/env bash
#MISE description="Run the framework's tests"
#MISE dir="{{ config_root }}"
set -euo pipefail

printf '\n== bats ==\n'
bats --print-output-on-failure test

printf '\n== templates ==\n'
while IFS= read -r f; do
  bash -n "$f"
done < <(find templates -type f \( -path '*/.mise/tasks/*.tmpl' -o -path '*/hooks/*.tmpl' -o -name '*.sh' \) | sort)
echo ok

printf '\n== examples ==\n'
mise run -q examples
