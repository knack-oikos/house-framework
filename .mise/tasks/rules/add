#!/usr/bin/env bash
#MISE description="Insert a domain rule set into a house's contract"
#USAGE arg "<set>" help="One of: money, identity, data, review"
#USAGE flag "--house <path>" help="The house directory; defaults to the current directory"
#USAGE flag "--binds <agent>" help="The agent the rule set binds; defaults to 'the agent whose charge it names'"
#USAGE example "house rules add money --binds caesar" header="Bind the money rules to the payments agent"
set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/house.sh"

SET="${usage_set:?a rule set name is required}"
HOUSE="$(house_root "${usage_house:-.}")"
SRC="$HOUSE_REPO_DIR/rules/$SET.md.tmpl"
[ -f "$SRC" ] || die "no such rule set: $SET (have: $(ls "$HOUSE_REPO_DIR/rules" | sed 's/\.md\.tmpl$//' | tr '\n' ' '))"

BINDS="${usage_binds:-}"
if [ -n "$BINDS" ]; then
  roster_has "$HOUSE" "$BINDS" || die "$BINDS is not on the roster of $(display_path "$HOUSE")"
  BINDS_TEXT="These bind $BINDS."
else
  BINDS_TEXT="These bind the agent whose charge they name."
fi

if grep -q "^### ${SET^} rules$" "$HOUSE/AGENTS.md"; then
  die "AGENTS.md already has a '${SET^} rules' section"
fi

TEXT="$(render_string "$(cat "$SRC")" "BINDS=$BINDS_TEXT")"$'\n'
insert_before_marker "$HOUSE/AGENTS.md" "<!-- house:rules -->" "$TEXT"
say "update: AGENTS.md (${SET^} rules)"
say "next: read the section and cut any line that does not apply here; a rule nobody can check is noise"
